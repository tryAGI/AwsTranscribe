<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <CLSCompliant>false</CLSCompliant>
    <NoWarn>$(NoWarn);MEAI001;CS1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup Label="Nuget">
    <Description>Microsoft.Extensions.AI adapter for the official AWS Transcribe batch and streaming .NET SDKs.</Description>
    <PackageTags>aws;transcribe;speech-to-text;stt;transcription;streaming;meai;dotnet</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.TranscribeService" Version="4.0.100.10" />
    <PackageReference Include="AWSSDK.TranscribeStreaming" Version="4.0.101.3" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
  </ItemGroup>

</Project>
